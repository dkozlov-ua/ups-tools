<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- Android 10 and later: follows the system's light or dark mode (values-night-v29). -->
  <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.DayNight">
    <item name="android:windowActionBar">false</item>
    <item name="android:windowNoTitle">true</item>
    <item name="android:colorPrimary">#0E7490</item>
    <item name="android:colorAccent">#0E7490</item>
    <item name="android:windowBackground">#F3F4F6</item>
    <item name="android:statusBarColor">@android:color/transparent</item>
    <item name="android:navigationBarColor">@android:color/transparent</item>
    <item name="android:windowLightStatusBar">true</item>
    <item name="android:windowLightNavigationBar">true</item>
  </style>
</resources>
