<?xml version="1.0" encoding="utf-8"?>
<!--
  The UPS battery widget: 4×1 cells to start with, resizable. Adding one asks which UPS it shows (UpsWidgetSetup);
  it can be asked again (long-press → reconfigure). The app updates it as readings come.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="80dp"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:minResizeWidth="180dp"
    android:minResizeHeight="70dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_ups"
    android:previewLayout="@layout/widget_ups"
    android:configure="com.dkozlov.upstools.UpsWidgetSetup"
    android:widgetFeatures="reconfigurable"
    android:description="@string/widget_ups_description"
    android:widgetCategory="home_screen" />
