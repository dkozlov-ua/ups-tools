<Window x:Class="UpsTools.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:UpsTools.Views"
        Title="UPS Tools"
        Icon="/Assets/app.ico"
        Width="980" Height="720" MinWidth="780" MinHeight="580"
        WindowStartupLocation="CenterScreen">
    <TabControl Margin="12,8,12,0" Padding="0">
        <TabItem Header="Dashboard">
            <views:DashboardView DataContext="{Binding Dashboard}" />
        </TabItem>
        <TabItem Header="Scripts">
            <views:ScriptsView />
        </TabItem>
        <TabItem Header="Configuration">
            <views:ConfigurationView />
        </TabItem>
    </TabControl>
</Window>
