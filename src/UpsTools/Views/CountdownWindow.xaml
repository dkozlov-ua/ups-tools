<Window x:Class="UpsTools.Views.CountdownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Assets/app.ico"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Topmost="True" ShowInTaskbar="True">
    <StackPanel Margin="24,20,24,20">
        <DockPanel>
            <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource IconFont}" FontSize="32" Text="&#xE7E8;"
                       Margin="0,2,16,0" VerticalAlignment="Top" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
            <StackPanel>
                <TextBlock x:Name="CountdownText" Style="{StaticResource CardTitle}" FontSize="18" TextWrapping="Wrap"
                           AutomationProperties.AutomationId="CountdownText" />
                <TextBlock x:Name="ReasonText" Style="{StaticResource Detail}" FontSize="13" Margin="0,4,0,0"
                           AutomationProperties.AutomationId="CountdownReason" />
            </StackPanel>
        </DockPanel>
        <ProgressBar x:Name="Remaining" Height="4" Margin="0,16,0,0" Maximum="1" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="NowButton" Click="Now_Click" Margin="0,0,8,0" MinWidth="110" />
            <!-- The default: Enter or Esc cancels, so nobody shuts the PC down by accident. -->
            <Button Content="Cancel" Click="Cancel_Click" IsDefault="True" IsCancel="True" MinWidth="110"
                    Style="{DynamicResource AccentButtonStyle}" />
        </StackPanel>
    </StackPanel>
</Window>
