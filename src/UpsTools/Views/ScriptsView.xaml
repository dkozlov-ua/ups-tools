<UserControl x:Class="UpsTools.Views.ScriptsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:UpsTools.ViewModels"
             AllowDrop="True" PreviewDragOver="View_PreviewDragOver" PreviewDrop="View_PreviewDrop">
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10,14,10,12">
            <StackPanel Margin="6,0,6,6">
                <TextBlock Text="Scripts" Style="{StaticResource PageTitle}" />
                <TextBlock Style="{StaticResource Detail}" FontSize="13" Margin="0,2,0,0"
                           Text="Run scripts when the UPS state changes, in the listed order (drag a script by its handle to reorder). A script set to wait must finish successfully before the next one starts; if it fails, the rest are skipped. When the grid comes back, the Grid lost and Battery low scripts that haven't started yet are skipped; when the UPS answers again, the UPS unreachable ones. .ahk, .bat, .cmd and .exe files open with their Windows file association; .ps1 files run hidden through PowerShell." />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding EventScripts}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:EventScriptsViewModel}">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                        <Button Content="Run now" Click="RunEvent_Click" Margin="0,0,8,0"
                                                AutomationProperties.Name="{Binding Title, StringFormat=Run the {0} scripts now}"
                                                ToolTip="Run all enabled scripts of this event now" />
                                        <Button Content="Add script…" Click="AddScript_Click" Style="{DynamicResource AccentButtonStyle}"
                                                AutomationProperties.Name="{Binding Title, StringFormat=Add a script to {0}}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Detail}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DockPanel>

                                <TextBlock Text="No scripts — nothing happens on this event." Margin="0,10,0,0"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontStyle="Italic"
                                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

                                <ItemsControl ItemsSource="{Binding Items}" Margin="0,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ScriptItemViewModel}">
                                            <!-- Named so drag and drop can find the row under the mouse. -->
                                            <Border x:Name="ScriptRow" BorderThickness="0,1,0,0" Background="Transparent" KeyDown="Row_KeyDown"
                                                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Padding="0,8,0,6">
                                                <Border.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Move up" Click="MoveUp_Click" InputGestureText="Alt+Up" />
                                                        <MenuItem Header="Move down" Click="MoveDown_Click" InputGestureText="Alt+Down" />
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="200" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <Border x:Name="Grip" Grid.RowSpan="3" Background="Transparent" Cursor="SizeAll"
                                                            Padding="2,0,8,0" VerticalAlignment="Stretch" Focusable="True"
                                                            FocusVisualStyle="{DynamicResource {x:Static SystemParameters.FocusVisualStyleKey}}"
                                                            ToolTip="Drag to change the order (or Alt+Up / Alt+Down)"
                                                            PreviewMouseLeftButtonDown="Grip_PreviewMouseLeftButtonDown"
                                                            PreviewMouseLeftButtonUp="Grip_PreviewMouseLeftButtonUp"
                                                            PreviewMouseMove="Grip_PreviewMouseMove">
                                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE76F;" FontSize="14"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                    </Border>

                                                    <CheckBox Grid.Column="1" IsChecked="{Binding Enabled}" VerticalAlignment="Center" MinWidth="0"
                                                              AutomationProperties.Name="{Binding FileName, StringFormat=Enable {0}}"
                                                              Margin="0,0,4,0" ToolTip="Enabled" />

                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock x:Name="Missing" FontFamily="{StaticResource IconFont}" Text="&#xE7BA;"
                                                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}" Margin="0,2,6,0"
                                                                       Visibility="Collapsed" ToolTip="File not found" />
                                                            <TextBlock x:Name="Shield" FontFamily="{StaticResource IconFont}" Text="&#xEA18;"
                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,6,0"
                                                                       Visibility="Collapsed" ToolTip="Runs as administrator" />
                                                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" AutomationProperties.AutomationId="ScriptName"
                                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding FullPath}" Style="{StaticResource Detail}"
                                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}" />
                                                    </StackPanel>

                                                    <TextBox Grid.Column="3" Text="{Binding Arguments, UpdateSourceTrigger=LostFocus}"
                                                             AutomationProperties.Name="{Binding FileName, StringFormat=Arguments for {0}}"
                                                             VerticalAlignment="Center" ToolTip="Command-line arguments (optional)" />
                                                    <TextBlock Grid.Column="3" Text="Arguments" IsHitTestVisible="False" Margin="12,0,0,0"
                                                               VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Arguments}" Value="">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <Button Grid.Column="4" Style="{StaticResource IconButton}" Content="&#xE768;"
                                                            Click="RunScript_Click" ToolTip="Run this script now" Margin="8,0,0,0"
                                                            AutomationProperties.Name="{Binding FileName, StringFormat=Run {0} now}" />
                                                    <Button Grid.Column="5" Style="{StaticResource IconButton}" Content="&#xE74D;"
                                                            Click="RemoveScript_Click" ToolTip="Remove"
                                                            AutomationProperties.Name="{Binding FileName, StringFormat=Remove {0}}" />

                                                    <WrapPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="4" Margin="0,4,0,0">
                                                        <CheckBox IsChecked="{Binding WaitForExit}" MinWidth="0" Margin="0,0,24,0"
                                                                  AutomationProperties.Name="{Binding FileName, StringFormat=Wait until {0} finishes}"
                                                                  Content="Wait until it finishes"
                                                                  ToolTip="The next script starts only after this one exits with exit code 0. If it fails (another exit code, or it can't be started), the scripts after it don't run." />
                                                        <CheckBox IsChecked="{Binding RunElevated}" IsEnabled="{Binding IsIdle}" MinWidth="0"
                                                                  AutomationProperties.Name="{Binding FileName, StringFormat=Run {0} as administrator}"
                                                                  Content="Run as administrator"
                                                                  ToolTip="Runs elevated without a UAC prompt when the event fires, so it works with nobody at the PC. Ticking it asks for administrator rights once, to create a scheduled task (\UpsTools in Task Scheduler) that runs the script." />
                                                    </WrapPanel>

                                                    <StackPanel x:Name="Note" Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="4" Orientation="Horizontal"
                                                                Margin="0,4,0,0"
                                                                Visibility="{Binding HasElevationNote, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7BA;" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="0,0,6,0" />
                                                        <TextBlock Text="{Binding ElevationNote}" Style="{StaticResource Detail}" VerticalAlignment="Center"
                                                                   AutomationProperties.AutomationId="ElevationNote" />
                                                        <Button Content="Repair" Click="Repair_Click" Margin="10,0,0,0" Padding="10,2"
                                                                AutomationProperties.Name="{Binding FileName, StringFormat=Repair {0}}"
                                                                IsEnabled="{Binding IsIdle}"
                                                                Visibility="{Binding CanRepair, Converter={StaticResource BoolToVisibility}}"
                                                                ToolTip="Create the administrator task again (asks for administrator rights)" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Exists}" Value="False">
                                                    <Setter TargetName="Missing" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RunElevated}" Value="True">
                                                    <Setter TargetName="Shield" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
