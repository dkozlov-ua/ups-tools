<UserControl x:Class="UpsTools.Views.ScriptsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:UpsTools.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10,14,10,12">
            <StackPanel Margin="6,0,6,6">
                <TextBlock Text="Scripts" Style="{StaticResource PageTitle}" />
                <TextBlock Style="{StaticResource Detail}" FontSize="13" Margin="0,2,0,0"
                           Text="Run scripts when the UPS state changes. Scripts start in the listed order without waiting for each other. .ahk, .bat, .cmd and .exe files open with their Windows file association; .ps1 files run hidden through PowerShell." />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding EventScripts}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:EventScriptsViewModel}">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                        <Button Content="Run now" Click="RunEvent_Click" Margin="0,0,8,0"
                                                ToolTip="Run all enabled scripts of this event now" />
                                        <Button Content="Add script…" Click="AddScript_Click" Style="{DynamicResource AccentButtonStyle}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Detail}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DockPanel>

                                <TextBlock Text="No scripts — nothing happens on this event." Margin="0,10,0,0"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontStyle="Italic"
                                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

                                <ItemsControl ItemsSource="{Binding Items}" Margin="0,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ScriptItemViewModel}">
                                            <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Padding="0,8,0,4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="200" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center" MinWidth="0"
                                                              Margin="0,0,4,0" ToolTip="Enabled" />

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock x:Name="Missing" FontFamily="{StaticResource IconFont}" Text="&#xE7BA;"
                                                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}" Margin="0,2,6,0"
                                                                       Visibility="Collapsed" ToolTip="File not found" />
                                                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding FullPath}" Style="{StaticResource Detail}"
                                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}" />
                                                    </StackPanel>

                                                    <TextBox Grid.Column="2" Text="{Binding Arguments, UpdateSourceTrigger=LostFocus}"
                                                             VerticalAlignment="Center" ToolTip="Command-line arguments (optional)" />
                                                    <TextBlock Grid.Column="2" Text="Arguments" IsHitTestVisible="False" Margin="12,0,0,0"
                                                               VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Arguments}" Value="">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE768;"
                                                            Click="RunScript_Click" ToolTip="Run this script now" Margin="8,0,0,0" />
                                                    <Button Grid.Column="4" Style="{StaticResource IconButton}" Content="&#xE74D;"
                                                            Click="RemoveScript_Click" ToolTip="Remove" />
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Exists}" Value="False">
                                                    <Setter TargetName="Missing" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
