<UserControl x:Class="UpsTools.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:UpsTools.Views">
    <DockPanel Margin="10,14,10,12">
        <StackPanel DockPanel.Dock="Top" Margin="6,0,6,6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" x:Name="Ranges" />
                <TextBlock Style="{StaticResource PageTitle}" AutomationProperties.AutomationId="HistoryTitle" VerticalAlignment="Center">
                    <TextBlock.Text>
                        <PriorityBinding>
                            <Binding Path="Selected.Title" StringFormat="History of {0}" />
                            <Binding Source="History" />
                        </PriorityBinding>
                    </TextBlock.Text>
                </TextBlock>
            </DockPanel>
            <TextBlock Style="{StaticResource Detail}" FontSize="13" Margin="0,2,0,0"
                       Text="The charge and the load of the last 7 days, a point a minute, as this PC saw them. Point at the chart to see a reading." />
        </StackPanel>

        <!-- The legend -->
        <WrapPanel DockPanel.Dock="Bottom" Margin="10,4,10,0">
            <WrapPanel.Resources>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                    <Setter Property="Margin" Value="6,0,18,0" />
                </Style>
            </WrapPanel.Resources>
            <Rectangle Width="16" Height="3" x:Name="BatteryKey" VerticalAlignment="Center" />
            <TextBlock Text="Battery (left axis)" />
            <Rectangle Width="16" Height="3" x:Name="LoadKey" VerticalAlignment="Center" />
            <TextBlock Text="Load (right axis)" />
            <Rectangle Width="14" Height="12" x:Name="OutageKey" VerticalAlignment="Center" />
            <TextBlock Text="On battery" />
            <Rectangle Width="14" Height="12" x:Name="MissingKey" VerticalAlignment="Center" />
            <TextBlock Text="No readings" />
            <Ellipse Width="7" Height="7" x:Name="EventKey" VerticalAlignment="Center" />
            <TextBlock Text="Events" />
        </WrapPanel>

        <Border Style="{StaticResource Card}" Padding="8,12,8,8">
            <views:HistoryChartView x:Name="Chart" History="{Binding Selected.History}"
                                    AutomationProperties.AutomationId="HistoryChart" AutomationProperties.Name="History chart" />
        </Border>
    </DockPanel>
</UserControl>
