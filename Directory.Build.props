<Project>
  <PropertyGroup>
    <!-- Windows 10 2004+ is the minimum for the WinRT Bluetooth LE APIs used here. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- VERSION (one line, X.Y.Z) is the only version; package.ps1 and publish.ps1 read it too. -->
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)VERSION').Trim())</Version>
    <Product>UPS Tools</Product>
    <Authors>Dmytro Kozlov</Authors>
    <Copyright>Copyright © Dmytro Kozlov</Copyright>
  </PropertyGroup>
</Project>
